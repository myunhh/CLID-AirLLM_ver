{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "gateId", "actionDigest", "gateNonce"],
  "properties": {
    "runId": {"type": "string", "minLength": 1},
    "gateId": {"type": "string", "minLength": 1},
    "actionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gateNonce": {"type": "string", "minLength": 1}
  }
}
